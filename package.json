{
  "name": "wcpos-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "links:check": "linkinator http://localhost:3000 --recurse --skip '^(?!http://localhost:3000)'",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install --with-deps",
    "smoke:checkout": "node scripts/smoke-checkout.mjs",
    "seo:indexnow": "node scripts/indexnow-ping.mjs",
    "discord:register-commands": "node scripts/register-discord-commands.mjs",
    "i18n:hardcoded": "tsx scripts/i18n/hardcoded-english.ts",
    "i18n:hardcoded:update": "tsx scripts/i18n/hardcoded-english.ts --update"
  },
  "dependencies": {
